# Copy to .env or export these variables in your shell.
# Never commit a real API key.

MATHLAB_PROVIDER_CONFIG=config/provider.toml
MATHLAB_PROVIDER_API_KEY=

# Optional local paths. The launcher supplies safe defaults.
MATHLAB_DATA_ROOT=~/.local/share/mathlab_linux
MATHLAB_DATABASE_URL=sqlite+pysqlite:///~/.local/share/mathlab_linux/mathlab.sqlite3

# Keep the local runtime loopback-only and without browser/UI auth.
MATHLAB_HOST=127.0.0.1
MATHLAB_PORT=3264
